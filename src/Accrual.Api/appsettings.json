{
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5435;Database=accrual_db;Username=app;Password=app;Maximum Pool Size=20"
  },
  "Users": {
    "BaseAddress": "http://localhost:8081/"
  },
  "Wallet": {
    "BaseAddress": "http://localhost:8083/"
  },
  "Workers": {
    "CalculationIntervalSeconds": 5,
    "OutboxIntervalSeconds": 2,
    "OutboxMaxAttempts": 8
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "IncludeScopes": true,
        "SingleLine": true,
        "TimestampFormat": "HH:mm:ss "
      }
    }
  },
  "AllowedHosts": "*"
}
