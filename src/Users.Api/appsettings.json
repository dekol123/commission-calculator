{
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=users_db;Username=app;Password=app"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
